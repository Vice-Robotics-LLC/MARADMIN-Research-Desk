{
  "name": "maradmin-research-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .project-local/worker-build",
    "build": "pnpm build:web && pnpm build:worker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm verify && wrangler deploy",
    "prepare:browser-import": "node --experimental-strip-types scripts/prepare-browser-import.ts",
    "db:migrate:local": "wrangler d1 migrations apply maradmin-research-desk --local",
    "db:migrate:remote": "wrangler d1 migrations apply maradmin-research-desk --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "packageManager": "pnpm@9.12.0"
}
