{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maradmin-research-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maradmin-research-desk",
      "database_id": "72a1ecba-7dc7-4aa4-8bd0-7691153f9af7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOURCE_ARCHIVE",
      "bucket_name": "maradmin-research-sources"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "384726",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "CATALOG_SOURCE_URL": "https://maradmin-api.vicerobotics.com/v1/catalog/bootstrap",
    "ENVIRONMENT": "production",
    "MAX_SEARCH_RESULTS": "20"
  },
  "triggers": { "crons": ["17 3 * * *"] }
}
